# 🐋 Variables de Entorno para Portainer Stack
# Copia este archivo como .env en el directorio del stack

# Configuración básica
TZ=America/Santiago
POGOCOMPI_PORT=80

# Configuración Watchtower
WATCHTOWER_SCHEDULE=0 2 * * *
WATCHTOWER_POLL_INTERVAL=3600
WATCHTOWER_CLEANUP=true
WATCHTOWER_LOG_LEVEL=info

# Recursos (opcional)
POGOCOMPI_MEMORY_LIMIT=256M
POGOCOMPI_MEMORY_RESERVATION=64M
POGOCOMPI_CPU_LIMIT=0.5
POGOCOMPI_CPU_RESERVATION=0.1

# Red (opcional)
NETWORK_SUBNET=172.25.0.0/16
NETWORK_GATEWAY=172.25.0.1

# Notificaciones Watchtower (opcional)
# WATCHTOWER_NOTIFICATIONS=slack
# WATCHTOWER_NOTIFICATION_SLACK_HOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Dominio personalizado (opcional)
# DOMAIN=pogocompi.localhost
# VIRTUAL_HOST=pogocompi.localhost
